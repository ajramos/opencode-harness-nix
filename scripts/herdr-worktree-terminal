#!/usr/bin/env bash
set -euo pipefail

state_home=${XDG_STATE_HOME:-${HOME}/.local/state}
log_file="$state_home/opencode-harness/worktree-terminal.log"
mkdir -p "$(dirname "$log_file")"

log() {
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >>"$log_file"
}

worktree=''
command_args=()

while (($#)); do
  case $1 in
    --working-directory|-d|--directory)
      if (($# < 2)); then
        log "missing worktree path after $1"
        exit 2
      fi
      worktree=$2
      shift 2
      ;;
    -e|--)
      shift
      command_args=("$@")
      break
      ;;
    *)
      log "unsupported launcher argument: $1"
      exit 2
      ;;
  esac
done

if [[ -z $worktree || ${#command_args[@]} -eq 0 ]]; then
  log 'missing worktree or command'
  exit 2
fi

if [[ ! -d $worktree ]]; then
  log "worktree directory does not exist: $worktree"
  exit 2
fi

herdr_bin=${HERDR_BIN:-herdr}
jq_bin=${JQ_BIN:-jq}
kitty_bin=${KITTY_BIN:-kitty}
focus_flag=--focus
if [[ ${HERDR_WORKTREE_FOCUS:-${HERDR_WORKTREE_FOCUS_DEFAULT:-1}} == 0 ]]; then
  focus_flag=--no-focus
fi

label=${worktree##*/}
command_text=''
for arg in "${command_args[@]}"; do
  printf -v quoted '%q' "$arg"
  command_text+="${command_text:+ }$quoted"
done

if [[ -n ${HERDR_WORKSPACE_ID:-} ]] && command -v "$herdr_bin" >/dev/null && command -v "$jq_bin" >/dev/null; then
  if created=$("$herdr_bin" tab create \
    --workspace "$HERDR_WORKSPACE_ID" \
    --cwd "$worktree" \
    --label "$label" \
    "$focus_flag" 2>>"$log_file"); then
    pane_id=$(printf '%s\n' "$created" | "$jq_bin" -r '.result.root_pane.pane_id // empty') || pane_id=''
    tab_id=$(printf '%s\n' "$created" | "$jq_bin" -r '.result.tab.tab_id // empty') || tab_id=''
    if [[ -n $pane_id ]] && "$herdr_bin" pane run "$pane_id" "$command_text" 2>>"$log_file"; then
      log "opened Herdr tab=${tab_id:-unknown} pane=$pane_id worktree=$worktree"
      exit 0
    fi
    log "Herdr pane launch failed tab=${tab_id:-unknown} pane=${pane_id:-missing} worktree=$worktree"
    if [[ -n $tab_id ]]; then
      "$herdr_bin" tab close "$tab_id" 2>>"$log_file" || true
    fi
  else
    log "Herdr tab creation failed worktree=$worktree"
  fi
else
  log "Herdr context or required commands unavailable worktree=$worktree"
fi

if [[ ${HERDR_WORKTREE_KITTY_FALLBACK:-${HERDR_WORKTREE_KITTY_FALLBACK_DEFAULT:-1}} == 1 ]] && command -v "$kitty_bin" >/dev/null; then
  log "using Kitty fallback worktree=$worktree"
  exec "$kitty_bin" -d "$worktree" -e "${command_args[@]}"
fi

log "session was not launched; Kitty fallback disabled or unavailable worktree=$worktree"
exit 1
